# VITRINE Universal Commerce Protocol (UCP) Endpoint Environment Configuration
GCP_PROJECT_ID=your-gcp-project-id
PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
AGENT_ENGINE_RESOURCE_NAME=projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>
AGENTS_HOST_URL=https://vitrine-agents-host-<project-number>.us-central1.run.app

# Datasets
BQ_DATASET_CATALOG=vitrine_dataset
BQ_DATASET_LEDGER=vitrine_dataset
FIRESTORE_DATABASE=(default)

# Service Config
PORT=8082
UCP_VERSION=1.0.0
UCP_MERCHANT_NAME="VITRINE Retailer Prototype"
