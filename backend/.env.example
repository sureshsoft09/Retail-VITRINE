# GCP Core Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
STAGING_BUCKET=gs://your-staging-bucket

# Vertex AI Agent Engine Deployed Resource
AGENT_ENGINE_RESOURCE_NAME=projects/YOUR_PROJECT_NUMBER/locations/us-central1/reasoningEngines/YOUR_ENGINE_ID

# Cloud Run Background / Sentinel Host
AGENTS_HOST_URL=https://vitrine-agents-host-YOUR_PROJECT_NUMBER.us-central1.run.app

# Port Configuration
PORT=8080

# BigQuery & Firestore Datasets
BQ_DATASET_CATALOG=vitrine_dataset
BQ_DATASET_LEDGER=vitrine_dataset
BQ_CONNECTION_ID=us-central1.gemini_conn
FIRESTORE_DATABASE=(default)

# Autonomy Policy & Guardrails
AUTONOMY_DISCOUNT_CAP_PCT=15.0
AUTONOMY_MARGIN_FLOOR_PCT=18.0
AUTONOMY_MAX_ORDER_VALUE_USD=250.0
MAX_TRANSACTION_TURNS=5
GLOBAL_KILL_SWITCH=False
