# ==============================================================================
# VITRINE Transaction Multi-Agent Subsystem Environment Configuration Template
# Directory: agents/src/vitrine_agents/transaction/.env
# ==============================================================================

# Google Cloud & Vertex AI Core Settings
GOOGLE_CLOUD_PROJECT=gcp-aibuildercup-project
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT_ID=gcp-aibuildercup-project
GCP_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional: Gemini Developer API Key (if not using Google Cloud Vertex AI ADC)
# GEMINI_API_KEY=your-gemini-api-key

# Vertex AI Model Pinning (Standardized for Enterprise Autonomy)
MODEL_REASONING=gemini-2.5-pro
MODEL_FAST=gemini-2.5-flash

# Model Context Protocol (MCP) Tool Servers
MCP_CATALOG_URL=http://localhost:8090
MCP_PROMISE_URL=http://localhost:8091
MCP_COMMERCE_URL=http://localhost:8092

# Autonomy & Guardrails Configuration
AUTONOMY_DISCOUNT_CAP_PCT=15.0
AUTONOMY_MARGIN_FLOOR_PCT=18.0
AUTONOMY_MAX_ORDER_VALUE_USD=250.0
MAX_TRANSACTION_TURNS=5
ENABLE_TRACING=true
