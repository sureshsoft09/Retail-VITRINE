# ==============================================================================
# VITRINE MCP Commerce Server Configuration (.env.example)
# ==============================================================================

PORT=8092
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Autonomy & Margin Guardrails
AUTONOMY_MARGIN_FLOOR_PCT=18.0
AUTONOMY_DISCOUNT_CAP_PCT=15.0
AUTONOMY_MAX_ORDER_VALUE_USD=250.0

# Datastores
BQ_DATASET_LEDGER=vitrine_commerce
FIRESTORE_DATABASE=vitrine-db
