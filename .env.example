# ==============================================================================
# VITRINE Environment Configuration Template
# Standardized Region: us-central1
# ==============================================================================

# GCP Core Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
STAGING_BUCKET=gs://your-gcp-project-id-agent-engine-staging

# Service Endpoints (Cloud Run)
BFF_URL=http://localhost:8080
CORE_API_URL=http://localhost:8081
UCP_URL=http://localhost:8082
AGENTS_HOST_URL=http://localhost:8083

# MCP Tool Servers (Private)
MCP_CATALOG_URL=http://localhost:8090
MCP_PROMISE_URL=http://localhost:8091
MCP_COMMERCE_URL=http://localhost:8092

# Vertex AI Agent Engine (vitrine-transaction)
# projects/<project_id>/locations/us-central1/reasoningEngines/<id>
AGENT_ENGINE_RESOURCE_NAME=projects/your-gcp-project-id/locations/us-central1/reasoningEngines/vitrine-transaction-id

# BigQuery Datasets & Tables
BQ_DATASET_CATALOG=vitrine_catalog
BQ_DATASET_LEDGER=vitrine_ledger
BQ_CONNECTION_ID=us-central1.gemini_conn

# Firestore
FIRESTORE_DATABASE=(default)

# Model Pinning
MODEL_PIN_PRIMARY=gemini-1.5-pro
MODEL_PIN_FAST=gemini-2.0-flash

# Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Guardrails & Autonomy Policy
MAX_TRANSACTION_TURNS=5
SESSION_BUDGET_CENTS_LIMIT=500
GLOBAL_KILL_SWITCH=false
REPLAY_MODE_ENABLED=false
RATE_LIMIT_PER_UID_HOURLY=20
AUTONOMY_DISCOUNT_CAP_PCT=15.0
AUTONOMY_MARGIN_FLOOR_PCT=18.0
AUTONOMY_MAX_ORDER_VALUE_USD=250.0

# Frontend Configuration (Public)
VITE_BFF_API_BASE=http://localhost:8080/api
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
